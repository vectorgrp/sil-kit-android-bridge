{
    "version": 3,
    "configurePresets": [
        {
            "name": "mixin-dirs",
            "description": "Set default binary / install dirs",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/_build/${hostSystemName}/${presetName}",
            "installDir": "${sourceDir}/_install/${hostSystemName}/${presetName}",
            "vendor": {
                "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
                    "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}",
                    "rsyncCommandArgs": [ "--copy-links", "--exclude", "_build" ]
                }
            }
        },

        {
            "name": "debug",
            "description": "Linux only. ConanCenter publishes no Windows Debug binaries, so a Debug build there compiles the whole dependency tree from source; use relwithdebinfo on Windows.",
            "inherits": ["mixin-dirs"],
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "inherits": ["mixin-dirs"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "relwithdebinfo",
            "inherits": ["mixin-dirs"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "relwithdebinfo",
            "configurePreset": "relwithdebinfo"
        }
    ],

    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "relwithdebinfo",
            "configurePreset": "relwithdebinfo"
        }
    ]
}
