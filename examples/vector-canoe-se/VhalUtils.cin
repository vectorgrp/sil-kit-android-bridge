// ---- string ----

int VhalSetString(char name[], char value[])
{
    callcontext properties.SetString cc;
    cc = properties.SetString.CallAsync(name, value);
    return testWaitForAnswer(cc, maxWait);
}

int VhalGetString(char name[], char value[])
{
    int status = -1;
    callcontext properties.GetString cc;
    cc = properties.GetString.CallAsync(name);
    status = testWaitForAnswer(cc, maxWait);
    if(status > 0) {
        strncpy(value, cc.Result, elcount(value));
    }
    return status;
}

// ---- bytes ----

// A vCDL "bytes" parameter is a plain CAPL byte array at the call site. Vector's
// own IoTEnablerBLE sample declares
//   consumed method result write(string name, bytes data);
// and calls it as write.CallAsync("RSSI/value", rssi) with a "byte rssi[1]",
// which is the same (string, bytes) shape as SetBytes here. A char array does
// not compile - that is the mapping for vCDL "string" - and the CAPL compiler
// reports "types of parameters do not match".
//
// elcount() on a bytes value gives the number of bytes actually present, which
// is how the same sample bounds its reads, so VhalGetBytes can report the length
// rather than leaving the caller to guess. memcpy copies the whole value, so
// size the destination for the largest property you read; the length is returned
// so an oversized result is at least detectable.
int VhalSetBytes(char name[], byte value[])
{
    callcontext properties.SetBytes cc;
    cc = properties.SetBytes.CallAsync(name, value);
    return testWaitForAnswer(cc, maxWait);
}

int VhalGetBytes(char name[], byte value[], long& length)
{
    int status = -1;
    callcontext properties.GetBytes cc;
    cc = properties.GetBytes.CallAsync(name);
    status = testWaitForAnswer(cc, maxWait);
    length = 0;
    if(status > 0) {
        length = elcount(cc.Result);
        memcpy(value, cc.Result);
    }
    return status;
}
