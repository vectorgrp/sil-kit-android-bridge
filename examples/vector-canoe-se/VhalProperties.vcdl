version 2.0;

import module "SilKit";

namespace VhalSilkit
{
  [Binding="SilKit"]
  interface IVhalToSilkit
  {
    consumed method void SetProperty(string name, int32 value);
    consumed method int32 GetProperty(string name);
    consumed method void SetPropertyFloat(string name, float value);
    consumed method float GetPropertyFloat(string name);
  }

  IVhalToSilkit vhalProperties;
}
