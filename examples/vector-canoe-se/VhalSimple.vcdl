// The VhalSimple API, CANoe side. The C++ half is source/VhalSimpleApi.hpp and
// the two must agree on the namespace, the object name, the method names and the
// parameter types. A mismatch does not fail loudly: SIL Kit simply stops matching
// and every call returns ServerNotReachable. GetApiVersion exists to make that
// case diagnosable.

import module "SilKit";

namespace VhalSimple
{
  [Binding="SilKit"]
  interface IVhalSimple
  {
    // Contract version. Bumped when a method changes or is removed, unchanged
    // when one is added. Keep in sync with VhalSimpleApi::kApiVersion.
    consumed method int32 GetApiVersion();

    // int32 also carries AOSP BOOLEAN properties, normalised to 0/1.
    consumed method int32 GetInt32(string name);
    consumed method void  SetInt32(string name, int32 value);

    consumed method int64 GetInt64(string name);
    consumed method void  SetInt64(string name, int64 value);

    consumed method float GetFloat(string name);
    consumed method void  SetFloat(string name, float value);

    consumed method string GetString(string name);
    consumed method void   SetString(string name, string value);

    // 'bytes' is a vCDL primitive sequence type; there is no [] suffix form.
    consumed method bytes GetBytes(string name);
    consumed method void  SetBytes(string name, bytes value);

    // Capability bitfield for one property, so a test can ask instead of
    // reading a 0 and guessing whether it meant "no such property".
    //
    //   bit0  0x01  exists in the VHAL's property configuration table
    //   bit1  0x02  readable
    //   bit2  0x04  writable
    //   bit3  0x08  a known AOSP name (answered without asking the VHAL)
    //   bits 8-11   which accessor to call: 0 none, 1 int32, 2 int64,
    //               3 float, 4 string, 5 bytes
    //   negative    the bridge could not reach the VHAL. The lower bits still
    //               hold what was answerable offline.
    //
    // 0 means nothing is known about the name at all. A known name that this
    // vehicle does not implement is 0x08 plus its type - non-zero with bit0
    // clear - so test (status & 0x01), never (status != 0). Bits 4-7 and 12-30
    // are reserved: mask what you need so a later addition stays additive.
    // Keep in sync with VhalSimpleApi::PropertyStatus in source/VhalSimpleApi.hpp.
    consumed method int32 GetPropertyStatus(string name);
  }

  IVhalSimple properties;
}
